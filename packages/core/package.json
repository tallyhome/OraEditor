{
  "name": "@ora-editor/core",
  "version": "0.1.3",
  "description": "Moteur OraEditor — Document Model, commandes, rendu, API publique",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/styles/ora-editor.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build --config ../../vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts"
  }
}
